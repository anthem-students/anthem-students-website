# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings -> Environment Variables (.env.local is never deployed).

# ── Supabase ─────────────────────────────────────────────────────────
# Project URL and the service-role key (Settings -> API). The service-role key
# bypasses row-level security and is only ever used server-side
# (app/(roster)/lib/supabaseAdmin.ts). Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────
# The public URL, with no trailing slash. Reset and approval emails build
# their links from it. Local: http://localhost:3000 — production:
# https://anthemstudents.org
NEXT_PUBLIC_SITE_URL=

# ── Access ───────────────────────────────────────────────────────────
# Fallback admin: gets the "someone is requesting leader access" email while
# no account has the admin role yet.
ADMIN_EMAIL=
# Shared view-only passcode, used whenever Settings -> Access doesn't define
# its own. Leave blank to disable passcode sign-in unless Settings sets one.
SITE_PASSWORD=

# ── Email (Resend) ───────────────────────────────────────────────────
# API key from resend.com, and a sender on a domain verified there, e.g.
# "ASM Roster <roster@anthemstudents.org>". Without RESEND_API_KEY no mail is
# sent; the message and its links are printed to the server console instead.
RESEND_API_KEY=
ROSTER_EMAIL_FROM=
